{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHWork",
  "identifier": "com.shenjingnan.dsh-work",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/dsh": "dsh/",
      "resources/pnpm": "pnpm/"
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "xz",
          "level": 9
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
