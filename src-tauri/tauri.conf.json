{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-work",
  "version": "0.1.0",
  "identifier": "com.shenjingnan.dsh-work",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/dsh": "dsh/",
      "resources/pnpm": "pnpm/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
